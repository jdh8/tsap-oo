@@ -0,0 +1,61 @@
+//! How long rounds run and how often they exhaust, by table size and dead
+//! tail: `HeuristicBot` self-play.
+//!
+//! ```sh
+//! cargo run --release --example length -- [rounds] [seed]
+//! ```
+
+use rand::SeedableRng as _;
+use rand::rngs::SmallRng;
+use tsap_oo::{Game, HeuristicBot, Rules, Seat, Step, Strategy, Table};
+
+fn main() {
+    let rounds: usize = std::env::args()
+        .nth(1)
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(2000);
+    let seed: u64 = std::env::args()
+        .nth(2)
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(0);
+    println!("players dead drawable  exhausted  mean_draws  median  p90  per_player");
+    for (players, tails) in [
+        (4, &[6][..]),
+        (3, &[6, 16, 20, 26, 30][..]),
+        (2, &[6, 26, 36, 46, 50][..]),
+    ] {
+        for &dead_tail in tails {
+            let mut rules = Rules::new();
+            rules.players = players;
+            rules.dead_tail = dead_tail;
+            let live = 112 - (20 * players + 1) - dead_tail;
+            let mut game = Game::new(rules, Seat::ALL[0]);
+            let mut rng = SmallRng::seed_from_u64(seed);
+            let mut exhausted = 0;
+            let mut draws = Vec::with_capacity(rounds);
+            for _ in 0..rounds {
+                let bots = Seat::ALL
+                    .map(|_| Some(Box::new(HeuristicBot::new(&rules)) as Box<dyn Strategy>));
+                let mut table = Table::new(game.deal(&mut rng), bots);
+                while table.step().expect("bots act legally") != Step::Finished {}
+                let round = table.round();
+                let result = round.result().expect("finished");
+                if result.winner.is_none() && result.foul.is_none() {
+                    exhausted += 1;
+                }
+                draws.push(live + dead_tail - round.pile_len());
+                let result = result.clone();
+                game.settle(&result);
+            }
+            draws.sort_unstable();
+            let mean = draws.iter().sum::<usize>() as f64 / rounds as f64;
+            println!(
+                "{players:7} {dead_tail:4} {live:8}  {:8.1}%  {mean:10.1}  {:6}  {:3}  {:10.1}",
+                100.0 * exhausted as f64 / rounds as f64,
+                draws[rounds / 2],
+                draws[rounds * 9 / 10],
+                mean / players as f64,
+            );
+        }
+    }
+}
