+/// The chance that a seat holding `held` of the `live` cards has `card`
+fn holds(live: Hand, held: usize, card: Card) -> f64 {
+    let (total, copies) = (live.len(), usize::from(live.count(card)));
+    let none: f64 = (0..held)
+        .map(|i| total.saturating_sub(copies + i) as f64 / total.saturating_sub(i).max(1) as f64)
+        .product();
+    1.0 - none
+}
+
+/// The chance that a seat holding `held` of the `live` cards can eat
+/// `card` into a meld: a pair, or the rest of a 將士象, 車馬包 or set of
+/// soldiers
+// ponytail: the partners are taken as independent, and whether the seat
+// wants the meld is not asked.
+fn edible(live: Hand, held: usize, card: Card) -> f64 {
+    let has = |rank: Rank| holds(live, held, Card { rank, ..card });
+    let run = match card.rank {
+        Rank::General => 0.0,
+        Rank::Advisor => has(Rank::General) * has(Rank::Elephant),
+        Rank::Elephant => has(Rank::General) * has(Rank::Advisor),
+        Rank::Chariot => has(Rank::Horse) * has(Rank::Cannon),
+        Rank::Horse => has(Rank::Chariot) * has(Rank::Cannon),
+        Rank::Cannon => has(Rank::Chariot) * has(Rank::Horse),
+        Rank::Soldier => {
+            // Two of the other three colours' soldiers or more
+            let [a, b, c] = <[f64; 3]>::try_from(
+                Color::ALL
+                    .into_iter()
+                    .filter(|&color| color != card.color)
+                    .map(|color| holds(live, held, Card { color, ..card }))
+                    .collect::<Vec<_>>(),
+            )
+            .expect("three other colours");
+            a * b + b * c + c * a - 2.0 * a * b * c
+        }
+    };
+    1.0 - (1.0 - holds(live, held, card)) * (1.0 - run)
+}
