+/// The ceilings with 0 and 1 outside generals before and after the
+/// control's eat of a pair, "-" for none, or "" for another act
+fn ceilings(rules: &new::Rules, view: &new::View<'_>, act: Act) -> String {
+    use new::susik::{Hand, Meld};
+    let Act::Claim(new::Claim::Eat(meld @ Meld::Pair(card))) = act else {
+        return String::new();
+    };
+    let shown = new::Seat::ALL
+        .into_iter()
+        .flat_map(|seat| view.exposed(seat))
+        .flat_map(|meld| meld.cards())
+        .chain(view.discards().iter().map(|&(_, card)| card))
+        .chain(view.offer().map(|offer| offer.card));
+    let live = shown.fold(Hand::FULL - view.hand(), Hand::without);
+    let (hand, exposed) = (view.hand(), view.exposed(view.seat()));
+    let eaten = [exposed, &[meld]].concat();
+    let show = |n: Option<u32>| n.map_or("-".to_owned(), |n| n.to_string());
+    (0..2)
+        .flat_map(|g| {
+            [
+                new::ceiling(rules, exposed, hand, live, g),
+                new::ceiling(rules, &eaten, hand.without(card), live, g),
+            ]
+        })
+        .map(show)
+        .collect::<Vec<_>>()
+        .join("\t")
+}
