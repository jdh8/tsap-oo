+"""Split the A/B by the pre-declared groups of doc/hu-ceiling.md, batch 2.
+
+    TRACE=1 ab/run.sh 800000 > out.txt
+    python3 ab/groups.py out.txt 800000
+
+A split's group is read from the ceilings after the control's eat of a
+pair: A when even one outside general leaves it short of the threshold,
+B when it reaches it only with that general, C when it reaches it with
+none.  Each row is how many deals parted that way, the mean score
+difference over their reshuffles with its standard error, and what they
+add to the difference per deal, with its standard error and 95% CI.
+"""
+import collections
+import sys
+
+THRESHOLD = 10
+
+
+def reach(ceiling):
+    return ceiling != "-" and int(ceiling) >= THRESHOLD
+
+
+rows = collections.defaultdict(list)
+for line in open(sys.argv[1]):
+    if not line.startswith("T\t"):
+        continue
+    fields = line.rstrip("\n").split("\t")
+    if len(fields) != 11:
+        rows["other act"].append(float(fields[-1]))
+        continue
+    _b0, a0, _b1, a1, mean = fields[6:]
+    group = "C" if reach(a0) else "B" if reach(a1) else "A"
+    rows[group].append(float(mean))
+deals = int(sys.argv[2])
+print(f"{'group':10} {'splits':>7} {'mean':>8} {'se':>6} {'per deal':>9} {'se':>7}  95% CI")
+for group, ds in sorted(rows.items()):
+    n = len(ds)
+    mean = sum(ds) / n
+    var = sum((d - mean) ** 2 for d in ds) / max(n - 1, 1)
+    # Per deal: the deals of other groups count 0.
+    per = sum(ds) / deals
+    per_se = ((sum(d * d for d in ds) - deals * per * per) / (deals - 1) / deals) ** 0.5
+    print(
+        f"{group:10} {n:7d} {mean:+8.3f} {(var / n) ** 0.5:6.3f} {per:+9.4f} {per_se:7.4f}"
+        f"  [{per - 1.96 * per_se:+.4f}, {per + 1.96 * per_se:+.4f}]"
+    )
