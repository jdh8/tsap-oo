diff --git a/ab/tally.py b/ab/tally.py
new file mode 100644
index 0000000..228af70
--- /dev/null
+++ b/ab/tally.py
@@ -0,0 +1,38 @@
+"""Group the splits `TRACE=1` prints by what each side did there.
+
+    TRACE=1 ab/run.sh 20000 > out.txt
+    python3 ab/tally.py out.txt 20000
+
+A row is "control's choice -> candidate's choice": how many deals parted
+that way, the mean score difference over the reshuffles of those deals with
+its standard error, and what they add to the difference per deal.
+"""
+import collections
+import re
+import sys
+
+EATS = {"Court": "將士象", "Field": "車馬包", "Soldiers": "兵卒", "Single": "將"}
+
+
+def kind(act):
+    if act.startswith("Discard"):
+        return "discard"
+    if "Pass" in act:
+        return "pass"
+    if "Pong" in act:
+        return "pong"
+    meld = re.match(r"Claim\(Eat\((\w+)", act).group(1)
+    return "eat pair" if meld == "Pair" else "eat " + EATS.get(meld, meld)
+
+
+rows = collections.defaultdict(list)
+for line in open(sys.argv[1]):
+    if line.startswith("T\t"):
+        _, _seed, _left, control, candidate, _hand, mean = line.rstrip("\n").split("\t")
+        rows[kind(control), kind(candidate)].append(float(mean))
+deals = int(sys.argv[2])
+print(f"{'control -> candidate':34} {'splits':>7} {'mean':>8} {'se':>6} {'per deal':>9}")
+for (control, candidate), ds in sorted(rows.items(), key=lambda row: sum(row[1])):
+    mean = sum(ds) / len(ds)
+    se = (sum((d - mean) ** 2 for d in ds) / max(len(ds) - 1, 1) / len(ds)) ** 0.5
+    print(f"{control + ' -> ' + candidate:34} {len(ds):7d} {mean:+8.3f} {se:6.3f} {sum(ds) / deals:+9.4f}")
